{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "enough.ng" }], "destination": "/enough" },
    { "source": "/", "has": [{ "type": "host", "value": "www.enough.ng" }], "destination": "/enough" },
    { "source": "/app", "has": [{ "type": "host", "value": "enough.ng" }], "destination": "/enough-app" },
    { "source": "/app", "has": [{ "type": "host", "value": "www.enough.ng" }], "destination": "/enough-app" },
    { "source": "/app/api/:path*", "destination": "https://sorted-api.vercel.app/:path*" },
    { "source": "/app", "destination": "https://sorted-app-preview.vercel.app/app" },
    { "source": "/app/:path*", "destination": "https://sorted-app-preview.vercel.app/app/:path*" }
  ]
}
