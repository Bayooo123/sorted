# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sorted?schema=public"

# Browser origins allowed to call this API (comma-separated). Only matters
# for browser callers (the landing page) — mobile's fetch isn't origin-
# checked. Defaults to sorted.com.ng + localhost if unset; see main.ts.
CORS_ALLOWED_ORIGINS=

# Auth (email/phone + password — see PLAN.md "Password-based auth")
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Africa's Talking (SMS — Notifications module only). Not currently used by
# any implemented notification event; kept for whichever gig/escrow/dispute
# slice needs SMS first.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_BASE_URL=https://api.africastalking.com

# Resend (email — Notifications module only). Not currently used by any
# implemented notification event. Separate from the landing page's own
# RESEND_API_KEY (Vercel env var) — this would be the server's own key,
# for a different deployment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Monnify (Payments module only — nothing else may read these)
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_WEBHOOK_IP_ALLOWLIST=35.242.133.146,35.242.228.62

# Which PaymentsProvider is active — 'manual_pilot' (default, no Monnify
# onboarding yet) or 'monnify' (once real Monnify credentials above are
# set). See payments.module.ts / manual-pilot.provider.ts.
PAYMENTS_PROVIDER_KEY=manual_pilot

# Manual pilot only (Payments module only — nothing else may read these).
# Disclosed to clients as a manual, founder-mediated pilot process, never
# as automated escrow — see FundEscrowScreen / index.html copy.
MANUAL_PILOT_ACCOUNT_NUMBER=
MANUAL_PILOT_ACCOUNT_NAME=
MANUAL_PILOT_BANK=

# Gates EscrowController's confirm-funding route (and any other pilot-era
# admin action) — shared secret via the x-admin-key header. Not a real
# admin/role system; a stopgap for a small pilot only.
ADMIN_API_KEY=

# Storage (proof media)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Platform config (data, not constants — seeded/overridable per gig)
DEFAULT_PLATFORM_FEE_BPS=1000
DEFAULT_STAKE_BPS=1000
