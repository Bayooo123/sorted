# Database
DATABASE_URL="postgresql://user:password@localhost:5432/sorted?schema=public"

# Browser origins allowed to call this API (comma-separated). Only matters
# for browser callers (the landing page) — mobile's fetch isn't origin-
# checked. Defaults to sorted.com.ng + localhost if unset; see main.ts.
CORS_ALLOWED_ORIGINS=

# Auth (email/phone + password — see PLAN.md "Password-based auth")
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Africa's Talking (SMS — Notifications module only). Not currently used by
# any implemented notification event; kept for whichever gig/escrow/dispute
# slice needs SMS first.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_BASE_URL=https://api.africastalking.com

# Resend (email — Notifications module only). Not currently used by any
# implemented notification event. Separate from the landing page's own
# RESEND_API_KEY (Vercel env var) — this would be the server's own key,
# for a different deployment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Paystack (Payments module only — nothing else may read these). Use the
# TEST secret key (sk_test_...) to start — no business KYC needed for
# test mode. Get these from the Paystack dashboard: Settings > API Keys
# & Webhooks.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Also set this same URL as the webhook URL in the Paystack dashboard:
# https://sorted-api.vercel.app/webhooks/paystack
# Optional, soft-enforced only (logged, not blocking) — see
# PaystackProvider.verifyWebhook's doc comment for why this isn't a hard
# gate. Leave unset to skip the check entirely.
PAYSTACK_WEBHOOK_IP_ALLOWLIST=

# Bachs (Payments module only — nothing else may read these). Built from
# Bachs documentation pasted into chat, not a live call from this sandbox
# (docs.bachs.io doesn't resolve here either) — see BachsProvider's top doc
# comment for exactly which request/response shapes are confirmed vs.
# inferred before relying on this with real money. Get the secret key from
# Bachs' dashboard (sandbox key to start, no live KYC needed for sandbox).
BACHS_SECRET_KEY=
# Defaults to Bachs' sandbox API if unset — see BachsProvider. Set to the
# live base URL only once ready to move real money.
BACHS_API_BASE_URL=
# Set this as the webhook URL in Bachs' dashboard:
# https://sorted-api.vercel.app/webhooks/bachs
# This is the webhook SIGNING SECRET Bachs' dashboard shows for that
# endpoint (not the API secret key above) — required, not soft-enforced
# (see BachsProvider.verifyWebhook): unset means every webhook is rejected,
# so release never auto-confirms under this provider until it's set.
BACHS_WEBHOOK_SECRET=

# Enough (module only — nothing else may read this). Reuses the same
# BACHS_SECRET_KEY / BACHS_API_BASE_URL above (same platform account), but
# needs its OWN webhook registration: create a second endpoint in Bachs'
# dashboard with event_source "connect" and event_types ["account.updated",
# "capability.updated", "collection.succeeded"], pointed at
# https://sorted-api.vercel.app/webhooks/bachs-connect — that registration
# returns its own signing_secret, distinct from BACHS_WEBHOOK_SECRET above.
# Required, not soft-enforced (see BachsConnectAccountProvider.
# verifyWebhook): unset means every Connect webhook is rejected, so an
# Enough account's virtual_accounts capability never gets picked up as
# active outside of sandbox (where submitIdentity's own immediate check
# already covers it — see EnoughAccountsService's doc comment).
BACHS_CONNECT_WEBHOOK_SECRET=

# Enough "Make Payment" (module only). Reuses BACHS_SECRET_KEY /
# BACHS_API_BASE_URL above (same platform account), but needs a THIRD
# webhook registration — platform-level event_source (not "connect"),
# event_types ["payout.paid", "payout.failed"], pointed at
# https://sorted-api.vercel.app/webhooks/bachs-payouts. Required, not
# soft-enforced (see BachsPayoutProvider.verifyWebhook): unset means
# every payout webhook is rejected, so a payment stays stuck on
# "processing" forever instead of resolving to completed/failed.
# IMPORTANT: this integration's request/response shapes were NOT
# confirmed against Bachs' own docs (docs.bachs.io doesn't resolve from
# this environment) — built from a third-party SDK generated from
# Bachs' OpenAPI spec instead. Confirm with Bachs before relying on this
# with real money — see BachsPayoutProvider's top doc comment.
BACHS_PAYOUTS_WEBHOOK_SECRET=

# Which Enough provider new signups are created under — 'bachs' (default),
# 'nomba', or 'paga'. See enough.module.ts's two DI factories. Switching
# this does NOT move existing accounts' deposits between providers —
# SettlementSweepService is what physically consolidates every provider's
# collected funds into Nomba's one settlement account before a real user
# payout (always via SETTLEMENT_PAYOUT_PORT, fixed to Nomba, never
# switched by this var).
ENOUGH_PROVIDER_KEY=bachs

# Paga (Enough module only — nothing else may read these). Built from
# Paga's real published docs (developer-docs.paga.com) pasted into chat
# 2026-10-30 — see PagaConnectAccountProvider's and PagaPayoutProvider's
# top doc comments for exactly which request/response shapes are
# confirmed vs. inferred-by-pattern before relying on this with real
# money. principal/credentials (Business API) and the Basic-auth pair
# (Collect API) are the SAME publicId/secretKey from Paga Business
# dashboard -> Developer Tools -> API Key; PAGA_HASH_KEY is the
# separate "hashkey" shown on that same page, used only inside the
# SHA-512 hash formula, never sent as a header itself.
PAGA_PUBLIC_ID=
PAGA_SECRET_KEY=
PAGA_HASH_KEY=
# Defaults to https://www.mypaga.com if unset (confirmed live Business
# API host). Set to Paga's sandbox host while testing.
PAGA_BUSINESS_API_BASE_URL=
# Defaults to https://collect.paga.com if unset — NOT itself confirmed
# by a pasted doc, only inferred from the test host (beta-collect.paga.com)
# by the same "drop the beta- prefix" pattern Paga's own docs confirmed
# for the Business API host. Override if this guess is wrong.
PAGA_COLLECT_API_BASE_URL=
# Set this as the callbackUrl when registering persistent payment
# accounts (see PagaConnectAccountProvider.createAccount) — or as the
# account-wide default callback URL in the Paga dashboard, whichever
# Paga's own setup flow calls for:
# https://sorted-api.vercel.app/webhooks/paga
# IMPORTANT: this callback's own `hash` field is NOT cryptographically
# verified yet (the formula Paga uses for it was never confirmed by any
# pasted doc — only the OUTGOING request-side hash formulas were). See
# PagaConnectAccountProvider.verifyWebhook's doc comment. Confirm with
# Paga support and/or set up IP Whitelisting
# (developer-docs.paga.com/docs/ip-whitelisting) before relying on this
# with real money.

# Which PaymentsProvider is active — 'manual_pilot' (default, until real
# credentials above are set), 'paystack', or 'bachs'. See
# payments.module.ts / manual-pilot.provider.ts / bachs.provider.ts.
PAYMENTS_PROVIDER_KEY=manual_pilot

# Manual pilot only (Payments module only — nothing else may read these).
# Disclosed to clients as a manual, founder-mediated pilot process, never
# as automated escrow — see FundEscrowScreen / index.html copy.
MANUAL_PILOT_ACCOUNT_NUMBER=
MANUAL_PILOT_ACCOUNT_NAME=
MANUAL_PILOT_BANK=

# Gates EscrowController's confirm-funding route (and any other pilot-era
# admin action) — shared secret via the x-admin-key header. Not a real
# admin/role system; a stopgap for a small pilot only.
ADMIN_API_KEY=

# Storage (proof media)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Platform config (data, not constants — seeded/overridable per gig)
DEFAULT_PLATFORM_FEE_BPS=1000
DEFAULT_STAKE_BPS=1000

# WhatsApp (Meta Cloud API — whatsapp module only). Use a DEDICATED phone
# number under the same Meta Business Manager as any other WhatsApp
# product you run — do not share one number's message stream between two
# unrelated products. WHATSAPP_TOKEN and WHATSAPP_PHONE_NUMBER_ID both
# come from Meta's developer dashboard (System Users > Generate Token, and
# the phone number's own settings page) — neither is obvious from the API
# docs alone.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any value you choose — enter the SAME value in Meta's dashboard when
# registering the webhook URL (https://sorted-api.vercel.app/webhooks/whatsapp).
# Meta calls that URL with this token once, as a GET, to verify you control
# it (see WhatsappWebhookController.verify) — get this working and confirmed
# in Meta's dashboard before anything else, it's the one step with no code
# fallback if skipped.
WHATSAPP_VERIFY_TOKEN=
# From the same Meta App's Basic Settings — verifies the POST webhook body
# actually came from Meta (HMAC-SHA256). Optional/soft-enforced only until
# set (see WhatsappWebhookController.verifySignature's doc comment), same
# pattern as PAYSTACK_WEBHOOK_IP_ALLOWLIST.
WHATSAPP_APP_SECRET=

# The customer-facing wa.me number (digits, no "+") — where every WhatsApp
# CTA on the marketing site (index.html) actually points, via /go/whatsapp
# (PLAN.md "Product analytics dashboard"). Defaults to the number already
# hardcoded in index.html's own WHATSAPP_NUMBER if unset, so this is only
# needed if that number ever changes.
WHATSAPP_CONTACT_NUMBER=2349031812675

# PLAN.md "WhatsApp intake: capture + human handoff" — E.164 WhatsApp
# number to notify (via the same bot) every time a new Lead is captured,
# so "a human will reach out shortly" is actually true instead of only
# happening whenever someone checks leads.html. Unset -> silent no-op,
# same pattern as every other optional WhatsApp config here.
LEAD_NOTIFICATION_PHONE=

# Shared by both direct-invite ("someone I already know" — PLAN.md
# "WhatsApp integration, Phase 3.1") and open-gig broadcast (Phase 4) for
# reaching someone outside Meta's 24h free-form-messaging window. Optional
# — leave unset and either case just doesn't send to someone who hasn't
# messaged Sorted recently (a direct invite tells the client and offers a
# fallback, see EscrowService.sendInvite; a broadcast silently skips that
# one recipient — see EscrowService.broadcastOpenGig). To actually cover
# this case, submit ONE template in Meta's dashboard: WhatsApp Manager >
# Message Templates > Create — category UTILITY (this notifies about an
# existing job, it's not marketing), name it anything (that name goes
# here), body with 3 variables in this exact order, generic enough to
# read naturally for either case:
#   "New job on Sorted: {{1}}. Location: {{2}}. Pay: {{3}}. Reply YES to
#    respond."
# Meta's review is external and can take anywhere from hours to several
# days, and isn't guaranteed to be approved as submitted.
WHATSAPP_INVITE_TEMPLATE_NAME=
# Must match the language you submitted the template in Meta's dashboard
# (e.g. "en_US", not "en") — Meta rejects a mismatched code at send time.
WHATSAPP_INVITE_TEMPLATE_LANG=en_US

# AI category classification (PLAN.md) — WhatsappCategoryClassifierService
# uses this to guess a gig's category from its free-text description,
# skipping the ~20-item numbered menu when confident. Optional: unset
# means every gig post falls back to the menu unchanged, same as before
# this feature existed — nothing breaks without it.
ANTHROPIC_API_KEY=

# KWIK delivery integration (PLAN.md "KWIK delivery integration") —
# DeliveryService/KwikDeliveryService dispatch a courier for gigs in the
# Laundry & Dry Cleaning submarket (pickup from client -> professional's
# shop on claim, then professional -> client on submission). All optional:
# unset means dispatch silently no-ops (logs a warning, writes a
# DeliveryTask row with a failureReason) — no gig, claim, or payout is
# ever blocked by a missing/failed courier call.
#
# IMPORTANT: KWIK_API_BASE_URL is not a guess-free value — the Apiary docs
# this was built from don't state it. Get the real base URL (and confirm
# the KWIK_PATH_* endpoints below) from KWIK's dashboard/support before
# this can work at all.
KWIK_API_BASE_URL=
KWIK_DOMAIN_NAME=
KWIK_ACCESS_TOKEN=
KWIK_VENDOR_ID=
KWIK_TEAM_ID=
# Fetch this once from KWIK's /getVehicle api for the vehicle size you
# want couriers to use (0=bike is the sensible default for garments) and
# hardcode the id here — this integration does not call /getVehicle itself.
KWIK_VEHICLE_ID=
# 524288 = End of Month Billing, assuming Sorted has a vendor account
# billed on account with KWIK rather than paying per task — confirm this
# is actually the arrangement before relying on it.
KWIK_PAYMENT_METHOD=524288
# Only set these if KWIK's real endpoint paths differ from the best-guess
# defaults in kwik-delivery.service.ts (see that file's top comment for
# which paths are confirmed from the docs vs. which are guesses).
KWIK_PATH_SEND_PAYMENT_FOR_TASK=
KWIK_PATH_GET_BILL_BREAKDOWN=
KWIK_PATH_GET_VEHICLE=
KWIK_PATH_CREATE_TASK=
KWIK_PATH_FETCH_JOB_STATUS=

# NIPOST digital postcode integration (PLAN.md "NIPOST digital postcode
# integration") — PostcodeService/NipostPostcodeProvider resolves a
# National Digital Postcode (e.g. "LA-11-W06-TC-10") to lat/lng, feeding
# the same Gig.locationGeoLat/Lng and User.professionalAddressLat/Lng
# columns DeliveryService already reads for KWIK dispatch. Optional:
# unset means resolution silently no-ops (logs a warning, returns null) —
# a gig/profile save with a postcode still succeeds, it's just not
# geocoded. Confirmed live against NIPOST's real API as of Oct 2026.
NIPOST_POSTCODE_API_BASE_URL=
# Only set if NIPOST's API requires one — omit to send no auth header.
NIPOST_POSTCODE_API_KEY=
# Only set if the real endpoint path differs from the confirmed default
# (GET /v1/lookup?code=...).
NIPOST_POSTCODE_PATH_LOOKUP=

# Daily founder briefing email (PLAN.md "Daily founder briefing email") —
# DigestService computes the previous full UTC day's activity (site visits,
# orders, completed transactions + value, disputes, KYC, delivery
# failures) and emails it to every address below. Triggered once a day by
# the Vercel Cron job in vercel.json (adjust the schedule there if a
# different time is wanted — default is 06:00 UTC / 07:00 WAT).
#
# Comma-separated, e.g. "adebayo@sorted.com.ng,cofounder@sorted.com.ng".
# Unset -> the cron runs and no-ops (logged), no email sent to no one.
FOUNDER_DIGEST_RECIPIENTS=

# Required for the cron endpoint itself (GET /cron/daily-digest) to accept
# a request — Vercel automatically sends "Authorization: Bearer <this
# value>" on its own cron-triggered calls once this is set on the project.
# Unlike most optional secrets in this file, this one does NOT soft-enforce:
# unset means the endpoint rejects every request, since a daily digest is
# cheap to abuse if the URL ever leaked. Generate any long random string.
CRON_SECRET=
